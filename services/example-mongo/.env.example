# example-mongo — local configuration. Copy to .env (git-ignored) and adjust.
# Deployed environments provide the same variables as real env vars.

APP_NAME=example-mongo
APP_ENV=local
APP_VERSION=dev
APP_ADMIN_ADDR=:8091

LOG_LEVEL=debug
LOG_FORMAT=text

HTTP_ADDR=:8090

# Local dev: auth off, callers identified by the X-Dev-User-ID header.
# Refused in staging/production.
AUTH_ENABLED=false
AUTH_AUTHORIZER=allow-all
# AUTH_JWKS_URL=http://localhost:4444/.well-known/jwks.json
# AUTH_ISSUER=http://localhost:4444/
# AUTH_AUDIENCE=example-mongo-api

MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=example_mongo

KAFKA_BROKERS=localhost:9092
KAFKA_DEFAULT_REPLICATION=1
# Topics this service consumes (comma separated). Empty = its own topic (demo).
# The example consumes example-pg's item events to show cross-service flow.
CONSUMER_TOPICS=example-pg.item.v1

OTEL_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
